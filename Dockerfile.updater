# Dockerfile for frame-updater, the component that applies a FrameUpdate: it
# moves Hearthrack's own components to a signed FrameRelease, waits for each to
# become ready, and puts them back if one does not
# (docs/specs/2026-11-24-mise-a-jour-en-un-clic.md). Its own minimal image, like
# authd and uiproxy: it holds the one grant that can change another component's
# image, so nothing else lives next to it.
#
# The image also carries /release-sync, the component that copies signed
# releases from the registry into FrameRelease objects. They are two binaries
# run as two Deployments under two ServiceAccounts: the updater reads what
# release-sync verified and cannot write it. The updater is the image's
# entrypoint; release-sync's Deployment sets its command.
FROM --platform=$BUILDPLATFORM golang:1.27 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -a -o updater cmd/updater/main.go && \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -a -o release-sync cmd/release-sync/main.go

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/updater .
COPY --from=builder /workspace/release-sync .
USER 65532:65532

ENTRYPOINT ["/updater"]
