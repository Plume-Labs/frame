# Dockerfile for authd, the Cluster Control UI's authentication surface
# (WebAuthn/password login, session cookies, OIDC discovery/JWKS, bootstrap).
# Kept separate from Dockerfile (the UI) and Dockerfile.controller (the
# operator) for the same reason as the latter: each binary gets its own
# minimal image rather than a shared one that overgrants what a compromised
# container could reach.
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -a -o authd cmd/authd/main.go

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/authd .
USER 65532:65532

ENTRYPOINT ["/authd"]
