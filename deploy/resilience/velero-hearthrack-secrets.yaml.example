# OPT-IN, not applied by default (hence the .example suffix).
#
# Secrets and ConfigMaps of the operator's namespace: BMC credentials, authd
# signing keys, webhook certificates. These are credentials: do NOT point this
# at the `default` location of velero.yaml (plain-HTTP bucket, no server-side
# encryption). Create a BackupStorageLocation with HTTPS and encryption first,
# put its name in storageLocation below, then `kubectl apply -f` this file.
apiVersion: velero.io/v1
kind: Schedule
metadata:
  name: hearthrack-system-secrets
  namespace: velero
spec:
  schedule: "30 2 * * *"
  template:
    includedNamespaces:
      - frame-system
    includedResources:
      - secrets
      - configmaps
    snapshotVolumes: false
    storageLocation: encrypted   # your encrypted BackupStorageLocation
    ttl: 720h
