# Dockerfile for the Frame node agent: a privileged, hostPID DaemonSet pod
# that applies and observes node-local tuning (KSM, tuned profile, CPU
# manager policy). Kept separate from Dockerfile.controller and Dockerfile.authd
# for the same reason as those: each binary gets its own minimal image rather
# than a shared one that overgrants what a compromised container could reach —
# and this one is the most sensitive of the three, since it runs
# host-root-equivalent on every node it lands on.
#
# Unlike the other two, the runtime stage cannot be distroless/static: tuned
# is not installed on these nodes' base OS (see
# docs/superpowers/specs/2026-08-16-frame-node-tuning-operator-design.md,
# "Delegation to tuned"), so the agent image carries it — tuned owns sysctls,
# CPU governor, disk scheduler, and kernel-module loading, all of which Frame
# declares by profile name and never restates. `tuned` pulls python, hence
# the materially larger runtime base than the other two agents' distroless
# images.
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -a -o frame-agent cmd/agent/main.go

FROM debian:13-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends tuned && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/frame-agent /frame-agent

ENTRYPOINT ["/frame-agent"]
