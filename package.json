    "//overrides": {
        "why": "Every entry in `overrides` below must say what it pins and why, so a future reader knows when it is safe to drop. An override with no recorded reason gets kept forever out of fear, or removed blind.",
        "picomatch": "Exact-pins the 4.x that tinyglobby, vite and vitest all request as ^4.0.3, so the three resolve to one copy instead of drifting apart on separate installs. Reproducibility, not an advisory.",
        "path-to-regexp": "Defensive floor against the ReDoS advisories affecting <8.0.0 (GHSA-9wv6-86v2-598j, GHSA-rhx6-c78j-4q9w). Nothing in the current tree depends on path-to-regexp at all, so this pins nothing today; it exists to stop a transitive re-entry below 8.x. Safe to drop once something enforces that floor.",
        "lodash": "Was 4.18.0 until 2026-08-09, which npm's own registry metadata marks 'Bad release. Please use lodash@4.17.21 instead.' The only dependent, recharts, asks for ^4.17.21, so this override is not what keeps lodash past the <4.17.21 prototype-pollution advisories (CVE-2020-8203, CVE-2021-23337) — recharts' own range already does. It exists to pin resolution to one known-good version rather than let ^4.17.21 float onto whatever is newest, which is exactly how 4.18.0 got in. Do not raise this to 4.18.0.",
        "@typescript-eslint/typescript-estree.minimatch": "Scoped exact-pin of the ^9.0.4 that typescript-estree requests, keeping it off the root's minimatch 3.1.2 and on one 9.x copy."
    },
    "overrides": {
        "picomatch": "4.0.4",
        "path-to-regexp": "8.4.2",
        "lodash": "4.17.21",
        "@typescript-eslint/typescript-estree": {
            "minimatch": "9.0.7"
        }
    }
}
